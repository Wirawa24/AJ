      "cell_type": "code",
      "source": [
        "dataset = load_dataset(\"ReactiveAI/passkey-retrieval\", \"to-4k\")"
      ],
      "metadata": {
        "id": "awjWkJl4LlYe"
      },
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "b7774fbf",
        "outputId": "b2b470dd-11dd-4f30-b87d-e35b32ebb281"
      },
      "source": [
        "import re\n",
        "import pandas as pd\n",
        "\n",
        "# Create a DataFrame from our dataset if not already done\n",
        "df_train = pd.DataFrame(dataset['train'])\n",
        "\n",
        "passkeys = set()\n",
        "\n",
        "# Standard passkey-retrieval pattern: look for names of passkeys in queries/answers\n",
        "# Usually they appear in contexts like: \"The passkey is 'XXXX'\" or \"private passkey is 'XXXX'\"\n",
        "for index, row in df_train.iterrows():\n",
        "    for item in row['interactions']:\n",
        "        query = item.get('query', '')\n",
        "        answer = item.get('answer', '')\n",
        "\n",
        "        # Search in both query and answer for phrases like \"passkey is '...'\"\n",
        "        for text in [query, answer]:\n",
        "            matches = re.findall(r\"(?:passkey|password|code)\\s+is\\s+['\\\"]([^'\\\"]+?)['\\\"]\", text, re.IGNORECASE)\n",
        "            for match in matches:\n",
        "                cleaned = match.strip()\n",
        "                # Simple heuristic to make sure it's a passkey (not a massive paragraph)\n",
        "                if 2 < len(cleaned) < 40:\n",
        "                    passkeys.add(cleaned)\n",
        "\n",
        "print(f\"Total unique passkeys found: {len(passkeys)}\")\n",
        "print(\"Sample of unique passkeys:\", sorted(list(passkeys))[:10])"
      ],
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total unique passkeys found: 194\n",
            "Sample of unique passkeys: ['The abject heifer types petition', 'The abortive grandson rinses belief', 'The accidental kamikaze inlays chaplain', 'The adamant subtitle fears itinerary', 'The addicted gamebird busts inscription', 'The adhesive ambience sprays temp', 'The annoyed airspace enters candidacy', 'The ashamed slavery sighs environment', 'The aware maker sucks burro', 'The bitter stylus improves meridian']\n"
          ]
        }
      ]
